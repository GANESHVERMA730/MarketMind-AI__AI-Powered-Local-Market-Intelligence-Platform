# Copy this file to .env and fill in local values. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB (local or Atlas). Example local URI:
MONGODB_URI=mongodb://127.0.0.1:27017/marketmind

# JWT — use a long random value. Never commit the real secret.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Password hashing cost (10 is a reasonable default)
BCRYPT_ROUNDS=10

# CORS: comma-separated origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Python forecasting service (local)
ML_SERVICE_URL=http://127.0.0.1:8000

# Optional shared secret between Express and the ML service
ML_SERVICE_KEY=

# Demo seeding (used by scripts, not by the public API)
DEMO_SEED=42
